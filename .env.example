# Optional TURN relay for voice calls between different networks.
# Copy to .env.local (and add the same variables in Vercel project settings).
# Free TURN credentials: https://www.metered.ca/tools/openrelay/ (or any TURN provider)
VITE_TURN_URLS=turn:your-turn-host:80,turn:your-turn-host:443,turns:your-turn-host:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
